  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
