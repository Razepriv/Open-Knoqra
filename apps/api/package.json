{
  "name": "@knoqra/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./cursor": "./src/lib/cursor.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "emit-openapi": "tsx scripts/emit-openapi.ts && biome format --write ../../packages/api-client",
    "cf-typegen": "wrangler types",
    "auth:generate": "pnpm dlx auth@1.7.20 generate --config scripts/better-auth.config.ts --output .wrangler/auth-schema.generated.ts --yes",
    "email:preview": "tsx scripts/email-preview.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.20",
    "@hono/zod-openapi": "^1.6.3",
    "@knoqra/brand": "workspace:*",
    "@knoqra/core": "workspace:*",
    "@knoqra/db": "workspace:*",
    "@knoqra/providers": "workspace:*",
    "@knoqra/tokens": "workspace:*",
    "@sentry/cloudflare": "11.12.0",
    "better-auth": "1.7.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@knoqra/config": "workspace:*",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  }
}
